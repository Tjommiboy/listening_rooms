# Copy to .env.local for `npm run dev`. In production, set these as Worker
# secrets: npx wrangler secret put VIPPS_CLIENT_SECRET (etc.)
# Never expose secret keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vipps MobilePay (from portal.vippsmobilepay.com → Utvikler → API-nøkler).
# The same keys are used for Vipps Login and for Recurring payments.
# Add <APP_URL>/api/auth/vipps/callback as a redirect URI for Vipps Login.
VIPPS_ENV=test
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
VIPPS_WEBHOOK_SECRET=

# Vipps partner keys (Management API) – lets the "Get paid" wizard prefill each
# band's own Vipps application and read back its sales unit (MSN). Only in
# production; from the partner portal once Listening Rooms is a Vipps partner.
# Locally, VIPPS_FAKE=true simulates it (no keys needed).
VIPPS_PARTNER_CLIENT_ID=
VIPPS_PARTNER_CLIENT_SECRET=
VIPPS_PARTNER_SUBSCRIPTION_KEY=
VIPPS_PARTNER_PRICE_PACKAGE_ID=   # optional: GET /management/v1/partners/price-packages
VIPPS_PARTNER_MCC=                # optional: merchant category code to preselect

# Stripe – card payments for people outside Norway (they log in by email).
# Keys: dashboard.stripe.com → Developers → API keys. Turn on Connect.
# Webhook: <APP_URL>/api/stripe/webhook, registered twice (your account, and
# "connected accounts"), each with its own signing secret. Pick API version
# 2024-06-20 for both endpoints (the version lib/stripe.ts is pinned to).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Email login links (https://resend.com). Locally without a key, the link is
# shown on the login page when ALLOW_DEMO_LOGIN=true.
RESEND_API_KEY=
EMAIL_FROM=

# Protects /api/cron/charges (the daily job that creates monthly charges).
# Any long random string; set it as a Worker secret in production too.
CRON_SECRET=

# Per-band R2 buckets (each band gets its own private bucket, created
# automatically). Leave empty locally: `npm run dev` then keeps each band's
# "bucket" as a folder in local storage under .wrangler/state.
R2_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=      # API token with "Workers R2 Storage: Edit"
R2_ACCESS_KEY_ID=          # R2 API token, Object Read & Write, all buckets
R2_SECRET_ACCESS_KEY=

# Where reports from the public report form are emailed (needs RESEND_API_KEY
# and EMAIL_FROM above). Reports are always saved and shown at /admin/rapporter.
SUPPORT_EMAIL=

# Platform admins (comma-separated user ids) – can download the TONO report
# for all bands.
ADMIN_USER_IDS=

# Local test switches. All of them are ignored in production builds.
ALLOW_DEMO_LOGIN=false        # sign in with just a name
ALLOW_DEMO_BAND_PLAN=false    # upload without paying the band plan
ALLOW_DEMO_MEMBERSHIP=false   # become a member of a room without Vipps
VIPPS_FAKE=false              # answer charge/stop calls and Vipps applications without contacting Vipps
