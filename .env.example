# Copy to .env.local for `npm run dev`. In production, set these as Worker
# secrets: npx wrangler secret put VIPPS_CLIENT_SECRET (etc.)
# Never expose secret keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vipps MobilePay (from portal.vippsmobilepay.com → Utvikler → API-nøkler).
# The same keys are used for Vipps Login and for Recurring payments.
# Add <APP_URL>/api/auth/vipps/callback as a redirect URI for Vipps Login.
VIPPS_ENV=test
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
VIPPS_WEBHOOK_SECRET=

# Per-band R2 buckets (each band gets its own private bucket, created
# automatically). Leave empty locally: `npm run dev` then keeps each band's
# "bucket" as a folder in local storage under .wrangler/state.
R2_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=      # API token with "Workers R2 Storage: Edit"
R2_ACCESS_KEY_ID=          # R2 API token, Object Read & Write, all buckets
R2_SECRET_ACCESS_KEY=

# Platform admins (comma-separated user ids) – can download the TONO report
# for all bands.
ADMIN_USER_IDS=

# Local test switches. All of them are ignored in production builds.
ALLOW_DEMO_LOGIN=false        # sign in with just a name
ALLOW_DEMO_BAND_PLAN=false    # upload without paying the band plan
ALLOW_DEMO_MEMBERSHIP=false   # become a member of a room without Vipps
